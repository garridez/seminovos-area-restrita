<script>
// O jQuery vem do /js/app.js, que o layout carrega com async DEPOIS deste conteúdo.
// Chamar $(...) direto aqui dava "$ is not defined" e nenhum botão da tela funcionava
// (o form fazia submit nativo via GET e a página só recarregava).
(function aguardarJquery(tentativas) {
    if (!window.jQuery) {
        if (tentativas > 0) {
            setTimeout(function () { aguardarJquery(tentativas - 1); }, 100);
        }
        return;
    }

window.jQuery(function ($) {
    // Gerar novo token do integrador
    $('.js-gerar-token').on('submit', function (e) {
        e.preventDefault();

        var $btn = $(this).find('button').prop('disabled', true);

        $.post('/integracoes/gerar-token', $(this).serialize())
            .done(function () {
                location.reload();
            })
            .fail(function () {
                alert('Erro ao gerar o token. Tente novamente.');
                $btn.prop('disabled', false);
            });
    });

    // Excluir token do integrador
    $(document).on('click', '.js-excluir-token', function () {
        if (!confirm('Excluir este token? O sistema que o utiliza perderá o acesso.')) {
            return;
        }

        $.post('/integracoes/excluir-token/' + $(this).data('id'))
            .done(function (res) {
                if (res && res.status === 200) {
                    location.reload();
                } else {
                    alert((res && res.detail) || 'Erro ao excluir o token.');
                }
            })
            .fail(function () {
                alert('Erro ao excluir o token. Tente novamente.');
            });
    });

    // Copiar token para a área de transferência
    $(document).on('click', '.js-copiar-token', function () {
        var token = $(this).data('token');
        var $btn = $(this);

        function feedback() {
            var htmlOriginal = $btn.html();
            $btn.html('<i class="fa fa-check" aria-hidden="true"></i> Copiado!');
            setTimeout(function () { $btn.html(htmlOriginal); }, 1500);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(token).then(feedback);
        } else {
            var input = document.createElement('input');
            input.value = token;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            feedback();
        }
    });

    // Salvar token do feed Webmotors
    $('.js-salvar-webmotors').on('submit', function (e) {
        e.preventDefault();

        var $btn = $(this).find('button').prop('disabled', true);

        $.post('/integracoes/salvar-webmotors', $(this).serialize())
            .done(function (res) {
                if (res && res.status === 200) {
                    alert('Token da Webmotors salvo com sucesso!');
                    location.reload();
                } else {
                    alert((res && res.detail) || 'Erro ao salvar o token.');
                }
            })
            .fail(function () {
                alert('Erro ao salvar o token. Tente novamente.');
            })
            .always(function () {
                $btn.prop('disabled', false);
            });
    });

    // Excluir token do feed Webmotors
    $(document).on('click', '.js-excluir-webmotors', function () {
        if (!confirm('Excluir o token da Webmotors? A sincronização do estoque será interrompida.')) {
            return;
        }

        $.post('/integracoes/excluir-webmotors')
            .done(function (res) {
                if (res && res.status === 200) {
                    location.reload();
                } else {
                    alert((res && res.detail) || 'Erro ao excluir o token.');
                }
            })
            .fail(function () {
                alert('Erro ao excluir o token. Tente novamente.');
            });
    });
});
})(150);
</script>
